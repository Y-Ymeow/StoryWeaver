<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192">
  <defs>
    <linearGradient id="grad192" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0ea5e9;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e94560;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- 背景 -->
  <rect width="192" height="192" rx="36" fill="#1a1a2e"/>
  
  <!-- 剧本图标 -->
  <g transform="translate(96, 96)">
    <!-- 左页 -->
    <path d="M -48 -30 L -48 40 Q -48 50 -38 50 L 0 40 L 0 -40 L -38 -40 Q -48 -40 -48 -30" 
          fill="url(#grad192)" opacity="0.9"/>
    
    <!-- 右页 -->
    <path d="M 48 -30 L 48 40 Q 48 50 38 50 L 0 40 L 0 -40 L 38 -40 Q 48 -40 48 -30" 
          fill="url(#grad192)" opacity="0.7"/>
    
    <!-- 中间的线 -->
    <line x1="0" y1="-40" x2="0" y2="50" stroke="#0ea5e9" stroke-width="3"/>
    
    <!-- 装饰 - 星星/火花 -->
    <circle cx="-28" cy="-18" r="4" fill="#e94560"/>
    <circle cx="28" cy="-12" r="3" fill="#0ea5e9"/>
    <circle cx="-20" cy="20" r="3" fill="#0ea5e9"/>
    <circle cx="24" cy="24" r="4" fill="#e94560"/>
    <circle cx="-30" cy="10" r="2" fill="#0ea5e9"/>
    <circle cx="30" cy="5" r="2" fill="#e94560"/>
  </g>
</svg>
